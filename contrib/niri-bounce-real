#!/usr/bin/env python3
"""Bounce all windows whose title matches a pattern around the screen
like an old-school wallpaper. Each window moves independently with a
random (but constant) speed and direction.

Usage: niri-bounce-real [--match <pattern>] [--fps <rate>]
                        [--min-speed <px>] [--max-speed <px>] [--exact]
                        [--bad-apple <N>]

If --bad-apple is given, N instances of the wl-bad-apple binary are
spawned before window discovery begins.
"""

import json
import os
import random
import signal
import subprocess
import sys
import threading
import time


def niri_msg(*args: str) -> str:
    result = subprocess.run(
        ["niri", "msg", *args],
        capture_output=True,
        text=True,
        env={**os.environ, "NIRI_SOCKET": os.environ.get("NIRI_SOCKET", "")},
    )
    if result.returncode != 0:
        print(f"niri msg failed: {result.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    return result.stdout


def niri_msg_json(msg_type: str):
    return json.loads(niri_msg("--json", msg_type))


def make_float(window_id: int):
    niri_msg("action", "move-window-to-floating", "--id", str(window_id))


def move_window(window_id: int, x: int, y: int):
    niri_msg(
        "action",
        "move-floating-window",
        "--id",
        str(window_id),
        "-x",
        str(x),
        "-y",
        str(y),
    )


def find_output_for_window(window, outputs):
    layout = window.get("layout", {})
    tile_pos = layout.get("tile_pos_in_workspace_view")
    if not tile_pos:
        return next(iter(outputs.items()))[1]

    wx, wy = tile_pos[0], tile_pos[1]
    ww, wh = layout.get("tile_size", [0, 0])
    wcx, wcy = wx + ww / 2, wy + wh / 2

    for out in outputs.values():
        lo = out.get("logical")
        if not lo:
            continue
        if (
            lo["x"] <= wcx <= lo["x"] + lo["width"]
            and lo["y"] <= wcy <= lo["y"] + lo["height"]
        ):
            return out

    return next(iter(outputs.items()))[1]


def match_title(title, pattern, exact):
    if title is None:
        return False
    if exact:
        return title == pattern
    return pattern.lower() in title.lower()


def bounce_window(window_id, bounds, running_event, min_speed, max_speed):
    """Bounce a single window in its own thread."""
    out_x, out_y, out_w, out_h, win_w, win_h = bounds
    max_x = out_w - win_w
    max_y = out_h - win_h

    directions = [(-1, -1), (-1, 1), (1, -1), (1, 1)]
    dx, dy = random.choice(directions)
    speed = random.randint(min_speed, max_speed)

    cur_x = out_w // 2
    cur_y = out_h // 2

    while running_event.is_set():
        cur_x += dx * speed
        cur_y += dy * speed

        if cur_x < 0:
            cur_x = 0
            dx = 1
        elif cur_x > max_x:
            cur_x = max_x
            dx = -1

        if cur_y < 0:
            cur_y = 0
            dy = 1
        elif cur_y > max_y:
            cur_y = max_y
            dy = -1

        cur_x = max(0, min(max_x, int(cur_x)))
        cur_y = max(0, min(max_y, int(cur_y)))

        move_window(window_id, cur_x, cur_y)
        time.sleep(0.01)


def main():
    match_pattern = "real"
    fps = 60
    min_speed = 2
    max_speed = 8
    exact = False
    bad_apple_count = 0

    args = sys.argv[1:]
    i = 0
    while i < len(args):
        if args[i] == "--match" and i + 1 < len(args):
            match_pattern = args[i + 1]
            i += 2
        elif args[i] == "--fps" and i + 1 < len(args):
            fps = int(args[i + 1])
            i += 2
        elif args[i] == "--min-speed" and i + 1 < len(args):
            min_speed = int(args[i + 1])
            i += 2
        elif args[i] == "--max-speed" and i + 1 < len(args):
            max_speed = int(args[i + 1])
            i += 2
        elif args[i] == "--bad-apple" and i + 1 < len(args):
            bad_apple_count = int(args[i + 1])
            i += 2
        elif args[i] == "--exact":
            exact = True
            i += 1
        else:
            print(f"Usage: {sys.argv[0]} [--match <pattern>] [--fps <rate>] "
                  "[--min-speed <px>] [--max-speed <px>] [--exact] "
                  "[--bad-apple <N>]",
                  file=sys.stderr)
            sys.exit(1)

    bad_apple_bin = os.path.expanduser(
        "~/projects/wl-bad-apple/target/release/wl-bad-apple"
    )

    spawns = []
    if bad_apple_count > 0:
        if not os.path.isfile(bad_apple_bin):
            print(f"bad-apple binary not found: {bad_apple_bin}", file=sys.stderr)
            sys.exit(1)

        audio_path = os.path.expanduser("~/projects/wl-bad-apple/bad-apple.webm")
        if os.path.isfile(audio_path):
            print("Playing audio...")
            p = subprocess.Popen(
                ["mpv", "--no-video", "--loop", audio_path],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            spawns.append(p)

        print(f"Spawning {bad_apple_count} wl-bad-apple instance(s)...")
        for _ in range(bad_apple_count):
            p = subprocess.Popen(
                [bad_apple_bin],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            spawns.append(p)
        time.sleep(0.5)

    windows = niri_msg_json("windows")
    outputs = niri_msg_json("outputs")
    out_list = list(outputs.values())

    matching = []
    for w in windows:
        if match_title(w.get("title"), match_pattern, exact):
            matching.append(w)

    if not matching:
        print(f"No windows found with title{' exactly' if exact else ''} "
              f"matching '{match_pattern}'",
              file=sys.stderr)
        sys.exit(1)

    print(f"Found {len(matching)} window(s):")
    for w in matching:
        print(f"  #{w['id']}  \"{w.get('title') or w.get('app_id') or 'unnamed'}\"")

    for w in matching:
        if not w.get("is_floating"):
            make_float(w["id"])
            time.sleep(0.2)

    if any(not w.get("is_floating") for w in matching):
        windows = niri_msg_json("windows")
        matching = [m for m in windows if m["id"] in {w["id"] for w in matching}]

    running_event = threading.Event()
    running_event.set()

    threads = []

    for w in matching:
        out = find_output_for_window(w, outputs)
        lo = out.get("logical", {})
        out_x = lo.get("x", 0)
        out_y = lo.get("y", 0)
        out_w = lo.get("width", 1920)
        out_h = lo.get("height", 1080)

        layout = w.get("layout", {})
        win_w = int(layout.get("tile_size", [200, 200])[0])
        win_h = int(layout.get("tile_size", [200, 200])[1])

        bounds = (out_x, out_y, out_w, out_h, win_w, win_h)

        t = threading.Thread(
            target=bounce_window,
            args=(w["id"], bounds, running_event, min_speed, max_speed),
            daemon=True,
        )
        t.start()
        threads.append(t)

    print(f"Bouncing {len(threads)} window(s) across the screen.")
    print(f"  speed range: {min_speed}-{max_speed} px/tick")
    print(f"  match:       '{match_pattern}'"
          f"{' (exact)' if exact else ' (substring)'}")
    print("Press Ctrl+C to stop")

    try:
        env = {**os.environ, "DISPLAY": ""}
        subprocess.run([",", "cacafire"], env=env)
    except KeyboardInterrupt:
        print()
    finally:
        running_event.clear()
        for t in threads:
            t.join(timeout=0.5)
        for p in spawns:
            p.send_signal(signal.SIGTERM)
            try:
                p.wait(timeout=1)
            except subprocess.TimeoutExpired:
                p.kill()


if __name__ == "__main__":
    main()
