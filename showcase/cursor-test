#!/usr/bin/env bash
set -euo pipefail

repo="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
esc=$'\033'

link() {
    printf '%s]8;;%s%s\\%s%s]8;;%s\\' "$esc" "$1" "$esc" "$2" "$esc" "$esc"
}

rule() {
    printf '\n\033[38;5;45m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\033[0m\n'
}

clear
printf '\033[1;38;5;117mNiri glass cursor test\033[0m\n'
printf 'Move slowly and quickly across each section. Stop abruptly after fast passes.\n'

rule
printf '\033[1mText and selection\033[0m\n\n'
printf 'The quick brown fox jumps over the lazy dog. Select this sentence in both directions.\n'
printf '0123456789  ABCDEFGHIJKLMNOPQRSTUVWXYZ  abcdefghijklmnopqrstuvwxyz\n'
printf 'Thin glyphs: iii lll ||| !!!     Wide glyphs: MMM WWW ### @@@\n'
printf '\nDrag across these tightly packed rows to test the text cursor and deceleration:\n'
for i in {1..5}; do
    printf 'row %d  alpha beta gamma delta epsilon zeta eta theta iota kappa lambda\n' "$i"
done

rule
printf '\033[1mHyperlinks\033[0m\n\n'
printf 'Large targets:  '
link 'https://github.com/YaLTeR/niri' 'Niri repository'
printf '    '
link 'https://github.com/kovidgoyal/kitty' 'Kitty repository'
printf '    '
link 'https://wayland.freedesktop.org/' 'Wayland'
printf '\n\n'
printf 'Dense targets: '
for label in One Two Three Four Five Six Seven Eight Nine Ten; do
    link "https://example.com/$label" "[$label]"
    printf ' '
done
printf '\n\n'
printf 'File targets:  '
link "file://$repo/config.kdl" 'config.kdl'
printf '    '
link "file://$repo/shaders/cursor-glass/glass.frag" 'glass.frag'
printf '    '
link "file://$repo/src/render_helpers/cursor_effect.rs" 'cursor_effect.rs'
printf '\n'

rule
printf '\033[1mEdges and rapid direction changes\033[0m\n\n'
printf '←━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━→\n'
printf '↑  zig  →  zag  ←  zig  →  zag  ←  zig  →  zag  ←  zig  →  zag  ↓\n'
printf '┌──────────┬──────────┬──────────┬──────────┬──────────┬──────────┐\n'
printf '│          │          │          │          │          │          │\n'
printf '├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤\n'
printf '│          │          │          │          │          │          │\n'
printf '└──────────┴──────────┴──────────┴──────────┴──────────┴──────────┘\n'

rule
printf '\033[1mColor and contrast\033[0m\n\n'
for color in {16..51}; do
    printf '\033[48;5;%dm  \033[0m' "$color"
done
printf '\n'
for color in {52..87}; do
    printf '\033[48;5;%dm  \033[0m' "$color"
done
printf '\n'
for color in {232..255}; do
    printf '\033[48;5;%dm   \033[0m' "$color"
done
printf '\n'

rule
printf '\033[1mPictures\033[0m\n\n'
images=(
    "$repo/docs/wiki/img/workspaces-dark.png"
    "$repo/docs/wiki/img/gradients-oklch.png"
)
if [[ ${TERM:-} == xterm-kitty* ]] && command -v kitty >/dev/null; then
    for image in "${images[@]}"; do
        printf '\033[2m%s\033[0m\n' "${image#$repo/}"
        kitty +kitten icat --align=left --fit=width --scale-up=no "$image"
        printf '\n'
    done
else
    printf 'Kitty graphics unavailable. Image files:\n'
    printf '  %s\n' "${images[@]}"
fi

rule
printf '\033[1mInteractive stop test\033[0m\n\n'
printf 'Sweep rapidly between the left and right markers, then stop over a link.\n\n'
link 'https://github.com/YaLTeR/niri' '◀ LEFT TARGET'
printf '                                                  '
link 'https://github.com/YaLTeR/niri' 'RIGHT TARGET ▶'
printf '\n\nPress Enter to redraw, or q then Enter to quit.\n'
while IFS= read -r answer; do
    [[ $answer == q ]] && break
    printf '\033[2J\033[H'
    exec "$0"
done
