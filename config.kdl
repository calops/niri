output "Technical Concepts Ltd 34R83Q X2452000226" {
  mode "3440x1440@170.000"
  variable-refresh-rate
}


screenshot-path "~/Pictures/Screenshots/%Y-%m-%dT%H:%M:%S.png"
hotkey-overlay
prefer-no-csd
animations {
    slowdown 1.000000;

    // window-open {
    //     duration-ms 5000
    //     curve "ease-out-expo"
    //     custom-shader r#"
    //         vec4 open_color(vec3 coords_geo, vec3 size_geo) {
    //             float progress = niri_clamped_progress;
    //             float inv = 1.0 - progress;
    //             float x = coords_geo.x;
    //             float y = coords_geo.y;
    //             float s = niri_random_seed * 6.283;
    //
    //             float drip = sin(x * 12.57 + s) * 0.18
    //                        + sin(x * 25.13 + s * 1.7) * 0.09
    //                        + sin(x * 43.98 + s * 0.4) * 0.04;
    //
    //             float offset = inv + drip * inv;
    //
    //             float stretch = 1.0 + abs(drip) * 0.3 * inv;
    //             float remapped_y = (y - 0.5) / stretch + 0.5;
    //
    //             vec3 shifted = vec3(x, remapped_y + offset, 1.0);
    //             vec3 coords_tex = niri_geo_to_tex * shifted;
    //             return texture2D(niri_tex, coords_tex.st);
    //         }
    //     "#
    // }
}
overview { zoom 0.25; }

input {
  mouse { accel-speed 0.000000; }
  trackpoint { accel-speed 0.000000; }
  trackball { accel-speed 0.000000; }
  focus-follows-mouse max-scroll-amount="0%"

  touchpad {
    tap
    natural-scroll
    drag true
    drag-lock
    click-method "clickfinger"
  }

  keyboard {
    repeat-delay 600
    repeat-rate 25
    track-layout "global"
  }
}

layout {
  gaps 16
  focus-ring { off; }
  insert-hint { color "rgba(127 200 255 50%)"; }
  center-focused-column "on-overflow"
  always-center-single-column
  default-column-width

  struts {
    left 40
    right 40
    top 0
    bottom 0
  }

  border {
    width 0
    active-gradient angle=45 from="#f38ba8" in="oklch longer hue" relative-to="window" to="#a6e3a1"
    inactive-color "#6c7086"
  }

  shadow {
    off
    softness 40
    spread 0
    offset x=0 y=0
    draw-behind-window false
    color "#cdd6f4cc"
    inactive-color "#cdd6f4cc"
  }

  tab-indicator {
    corner-radius 5
    position "left"
  }

  preset-column-widths {
    proportion 0.333330
    proportion 0.500000
    proportion 0.666670
  }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 55
    // Margin around the silhouette that the shader can refract the backdrop
    // from, in logical pixels.
    effect-padding 32
    // Animate named cursor shape changes through signed-distance silhouettes.
    shape-transition-duration-ms 150
    // Stretch the silhouette slightly in the direction of cursor motion (0 disables).
    motion-effect-strength 1.0
    shader-pipeline {
        mask-pass "cursor-vectors"
        render-pass "dual-kawase-blur" passes=2 offset=1.2
        render-pass "custom" file="shaders/cursor-glass/glass.frag" scale=1.0
    }
    // Debug: swap the active pipeline for this to check whether the effect path
    // and the silhouette mask are actually running (magenta arrow = yes).
    // shader-pipeline {
    //     mask-pass "cursor-vectors"
    //     render-pass "custom" file="shaders/cursor-glass/debug.frag" scale=1.0
    // }
    // Alternative: build the shape in an analytic custom mask pass instead of
    // using the xcursor silhouette. Cheaper (no JFA/Poisson) but the shape is
    // whatever shape.frag draws, not the actual cursor outline. The render
    // shader must write transparent pixels outside the shape, since custom mask
    // passes fall back to CPU clipping.
    // shader-pipeline {
    //     mask-pass "custom" file="shaders/cursor-glass/shape.frag" scale=1.0
    //     render-pass "dual-kawase-blur" passes=1 offset=1
    //     render-pass "custom" file="shaders/cursor-glass/glass.frag" scale=1.0
    // }
}

environment {
    "ELECTRON_OZONE_PLATFORM_HINT" "auto"
    "NIXOS_OZONE_WL" "1"
}

blur {
    noise 0
    shader-pipeline {
        mask-pass "window-vectors"
        render-pass "dual-kawase-blur" passes=2 offset=3
        render-pass "custom" file="shaders/liquid-glass-faithful/glass.frag" scale=1.0
    }
}

// The shader background is a quickshell layer surface covering the output.
// -n keeps niri's config reloads from stacking extra instances.
spawn-sh-at-startup "qs -n -p $HOME/projects/niri/shader-bg-test"

binds {
  Mod+Ctrl+S          { screenshot-screen; }
  Mod+S               { screenshot; }
  Mod+Shift+S         { screenshot-window; }
  Mod+Ctrl+Shift+S    { spawn-sh "wl-paste | /nix/store/8qfp2a3zycii4bp1r8gfflcf9b3xjy5d-satty-0.20.1 --filename -"; }

  Mod+Ampersand       { focus-workspace "web"; }
  Mod+Eacute          { focus-workspace "dev"; }
  Mod+Quotedbl        { focus-workspace "work"; }
  Mod+Apostrophe      { focus-workspace "chat"; }
  Mod+Parenleft       { focus-workspace "games"; }
  Mod+Minus           { focus-workspace "misc"; }

  Mod+Down            { focus-window-or-workspace-down; }
  Mod+Up              { focus-window-or-workspace-up; }
  Mod+Left            { focus-column-left; }
  Mod+Right           { focus-column-right; }
  Mod+Page_Down       { focus-workspace-down; }
  Mod+Page_Up         { focus-workspace-up; }
  Mod+Shift+Down      { move-window-down-or-to-workspace-down; }
  Mod+Shift+Up        { move-window-up-or-to-workspace-up; }
  Mod+Shift+Left      { move-column-left-or-to-monitor-left; }
  Mod+Shift+Right     { move-column-right-or-to-monitor-right; }
  Mod+Ctrl+Right      { consume-or-expel-window-right; }
  Mod+Ctrl+Left       { consume-or-expel-window-left; }
  Mod+Shift+Page_Down { move-workspace-down; }
  Mod+Shift+Page_Up   { move-workspace-up; }

  Mod+T               { toggle-column-tabbed-display; }
  Mod+Shift+F         { toggle-window-floating; }
  Mod+C               { center-column; }
  Mod+Home            { focus-column-first; }
  Mod+End             { focus-column-last; }
  Mod+Shift+End       { move-column-to-last; }
  Mod+Shift+Home      { move-column-to-first; }
  Mod+Shift+Q         { close-window; }

  Mod+Backspace       { switch-preset-column-width; }
  Mod+Ctrl+F          { fullscreen-window; }
  Mod+Equal           { set-column-width "-10%"; }
  Mod+F               { maximize-column; }

  Mod+Tab             { toggle-overview; }
  Mod+L               { spawn-sh "/nix/store/763dwwp0pybvwrwn790qddk2dx7ygb5d-swaylock-effects-1.7.0.0/bin/swaylock"; }
  Mod+Plus            { set-column-width "+10%"; }
  Mod+Return          { spawn-sh "$HOME/projects/niri/showcase/terminal"; }
  Mod+Shift+Comma     { show-hotkey-overlay; }
  Mod+Shift+E         { quit; }
  Mod+Space           { spawn-sh "shell toggleRunner \"\""; }
  Mod+Shift+Space     { spawn-sh "1password --quick-access"; }

  Mod+Shift+WheelScrollDown cooldown-ms=150 { focus-column-right; }
  Mod+Shift+WheelScrollUp   cooldown-ms=150 { focus-column-left;  }

  Mod+WheelScrollDown  cooldown-ms=150 { focus-workspace-down; }
  Mod+WheelScrollLeft  cooldown-ms=150 { focus-column-left;    }
  Mod+WheelScrollRight cooldown-ms=150 { focus-column-right;   }
  Mod+WheelScrollUp    cooldown-ms=150 { focus-workspace-up;   }

  XF86AudioRaiseVolume  { spawn-sh "shell setVolume +0.05"; }
  XF86AudioLowerVolume  { spawn-sh "shell setVolume -0.05"; }
  XF86AudioMute         { spawn-sh "shell setMuted toggle"; }
  XF86AudioNext         { spawn-sh "playerctl next"; }
  XF86AudioPrev         { spawn-sh "playerctl previous"; }
  XF86AudioPlay         { spawn-sh "playerctl play-pause"; }
  XF86MonBrightnessUp   { spawn-sh "shell setBrightness +0.05"; }
  XF86MonBrightnessDown { spawn-sh "shell setBrightness -0.05"; }

  XF86LaunchA { toggle-overview; }
}

workspace "web"
workspace "dev"
workspace "work"
workspace "chat"
workspace "games"
workspace "misc"

window-rule {
  geometry-corner-radius 15.000000 15.000000 15.000000 15.000000
  clip-to-geometry true
}
window-rule {
  match is-floating=false
  shadow { off; }
}
window-rule {
  match app-id="^1Password$"
  match app-id="org.kde.polkit-kde-authentication-agent-1"
  open-floating true
}
window-rule {
  match app-id="^kitty$"
  open-floating false
  default-column-width { proportion 0.333333; }
  geometry-corner-radius 48 48 48 48
  clip-to-geometry true
  border { off; }
  shadow {
    on
    softness 32
    spread 2
    offset x=0 y=4
    color "#00000040"
    inactive-color "#00000028"
  }
  background-effect {
    xray false
    blur true
    noise 0.0
  }
}
window-rule {
  match app-id="^kitty-(circle|square|rounded)$"
  open-floating true
  default-column-width { proportion 0.25; }
  default-window-height { proportion 0.25; }
  border { off; }
  shadow {
    on
    softness 32
    spread 2
    offset x=0 y=4
    color "#00000040"
    inactive-color "#00000028"
  }
  background-effect {
    xray false
    blur true
    noise 0.0
  }
}
window-rule {
  match app-id="^kitty-circle$"
  default-floating-position x=64 y=0 relative-to="left"
  geometry-corner-radius 1000 1000 1000 1000
  background-effect {
    shader-pipeline {
        mask-pass "window-vectors"
        render-pass "dual-kawase-blur" passes=2 offset=2
        render-pass "custom" file="shaders/liquid-glass-faithful/glass.frag" scale=1.0
        // render-pass "custom" file="shaders/magnify/magnify.frag" scale=1.0
        // render-pass "custom" file="shaders/magnify/glass.frag" scale=1.0
    }
  }
}
window-rule {
  match app-id="^kitty-square$"
  geometry-corner-radius 0 0 0 0
}
window-rule {
  match app-id="^kitty-rounded$"
  geometry-corner-radius 100 100 100 100
  default-floating-position x=64 y=0 relative-to="right"
}
window-rule {
  match app-id="^niri-rickroll$"
  open-floating true
  default-column-width { proportion 0.32; }
  default-window-height { proportion 0.32; }
  default-floating-position x=64 y=64 relative-to="top-right"
  geometry-corner-radius 28 28 28 28
  clip-to-geometry true
}
window-rule {
  match title="^real$"
  open-floating true
  background-effect {
    xray false
    blur true
    noise 0.0
    shader-pipeline {
        mask-pass "region-vectors"
        render-pass "dual-kawase-blur" passes=1 offset=1
        render-pass "custom" file="shaders/prism-glass/region.frag" scale=1.0
    }
  }
}
window-rule {
  match app-id="^firefox(-beta)?$"
  default-column-width { proportion 0.666670; }
  open-on-workspace "web"
}
window-rule {
  match app-id="^Element$"
  match app-id="^Slack$"
  match app-id="^discord$"
  default-column-width { proportion 0.500000; }
  open-on-workspace "chat"
}
window-rule {
  match app-id="^Steam$"
  match app-id="^Lutris$"
  default-column-width { proportion 0.500000; }
  open-on-workspace "games"
}

layer-rule {
  match namespace="quickshell"
  background-effect {
    xray false
    blur true
    noise 0.0
    shader-pipeline {
        mask-pass "region-vectors"
        render-pass "dual-kawase-blur" passes=2 offset=2
        render-pass "custom" file="shaders/liquid-glass-faithful/region.frag" scale=1.0
    }
  }
}

layer-rule {
  match namespace="cava-glass"
  background-effect {
    xray false
    blur true
    noise 0.0
    shader-pipeline {
        mask-pass "region-vectors"
        render-pass "dual-kawase-blur" passes=2 offset=2
        render-pass "custom" file="shaders/liquid-glass-faithful/region.frag" scale=1.0
    }
  }
}

layer-rule {
  match namespace="stained-glass-lock"
  background-effect {
    xray false
    blur true
    noise 0.0
    shader-pipeline {
        mask-pass "region-vectors"
        render-pass "dual-kawase-blur" passes=1 offset=1
        render-pass "custom" file="shaders/prism-glass/region.frag" scale=1.0
    }
  }
}

layer-rule {
  match namespace="magnify-glass"
  background-effect {
    xray false
    blur true
    noise 0.0
    shader-pipeline {
        mask-pass "window-vectors"
        render-pass "custom" file="shaders/magnify/magnify.frag" scale=1.0
        render-pass "custom" file="shaders/magnify/glass.frag" scale=1.0
    }
  }
}

layer-rule {
  match namespace="niri-backdrop"
  place-within-backdrop true
}
